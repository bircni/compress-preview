{
  "name": "compress-preview",
  "displayName": "Compress Preview",
  "description": "VS Code extension: preview ZIP, TAR, GZIP, 7z, XZ, BZIP2, Zstandard, EPUB, DOCX, PPTX, and XLSX archive contents directly in the editor",
  "publisher": "bircni",
  "version": "0.7.0",
  "icon": "assets/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bircni/compress-preview"
  },
  "homepage": "https://github.com/bircni/compress-preview",
  "bugs": {
    "url": "https://github.com/bircni/compress-preview/issues"
  },
  "keywords": [
    "zip",
    "tar",
    "tgz",
    "gzip",
    "gz",
    "7z",
    "xz",
    "bzip2",
    "bz2",
    "zstd",
    "zst",
    "jar",
    "apk",
    "vsix",
    "xpi",
    "epub",
    "docx",
    "pptx",
    "xlsx",
    "odt",
    "ods",
    "odp",
    "nupkg",
    "preview",
    "archive",
    "vscode",
    "unzip",
    "viewer",
    "files"
  ],
  "categories": [
    "Other",
    "Visualization"
  ],
  "galleryBanner": {
    "color": "#0f3d99",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.105.0"
  },
  "main": "dist/extension.js",
  "scripts": {
    "audit": "npm audit --audit-level high",
    "build": "npm run compile && npm run bundle && npm run copy:webview && npm run package",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node18 --external:vscode --outfile=dist/extension.js --sourcemap --banner:js=\"process.env.LZMA_NATIVE_DISABLE='1';\"",
    "check:fixtures": "tsx scripts/check-fixtures.ts",
    "check-unused": "knip",
    "clean": "rimraf dist",
    "compile": "tsc --project tsconfig.build.json",
    "copy:webview": "tsx scripts/copy-webview.ts",
    "format": "oxfmt --check \"src/**/*.ts\" \"scripts/**/*.ts\" \"vitest.config.mts\" \"*.json\"",
    "format:write": "oxfmt \"src/**/*.ts\" \"scripts/**/*.ts\" \"vitest.config.mts\" \"*.json\"",
    "generate:fixtures": "tsx scripts/generate-fixtures.ts",
    "install:code:debug": "npm run build && code --install-extension dist/extension.vsix --force",
    "uninstall:code:debug": "code --uninstall-extension bircni.compress-preview",
    "install:cursor:debug": "npm run build && cursor --install-extension dist/extension.vsix --force",
    "uninstall:cursor:debug": "cursor --uninstall-extension bircni.compress-preview",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "package": "vsce package --out dist/extension.vsix",
    "compile:e2e": "tsc --project tsconfig.e2e.json",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:e2e": "npm run bundle && npm run copy:webview && npm run compile:e2e && npm run test:e2e:host && npm run test:webview:browser",
    "test:e2e:host": "node out/e2e/runTest.js",
    "test:webview:browser": "vitest run --project e2e-browser",
    "test:report": "vitest run --coverage && echo 'HTML report at: .tmp/coverage/lcov-report/index.html'",
    "test:watch": "vitest",
    "release": "tsx scripts/release.ts",
    "coverage:summary": "tsx scripts/write-coverage-summary.ts",
    "validate": "npm run check-unused && npm run lint && npm run format && npm run check:fixtures && npm run test:coverage && npm run test:e2e && npm run build && npm run audit",
    "watch": "tsc --project tsconfig.build.json --watch"
  },
  "dependencies": {
    "7z-iterator": "^2.2.9",
    "fzstd": "^0.1.1",
    "tar-stream": "3.2.0",
    "unbzip2-stream": "^1.4.3",
    "xz-compat": "^1.2.7",
    "yauzl": "3.4.0"
  },
  "overrides": {
    "diff": "8.0.4",
    "serialize-javascript": "7.0.5"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tsconfig/node-lts": "24.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "26.2.0",
    "@types/tar-stream": "3.1.4",
    "@types/unbzip2-stream": "^1.4.3",
    "@types/vscode": "1.105.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@vscode/codicons": "^0.0.45",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.2",
    "glob": "^13.0.6",
    "jsdom": "30.0.1",
    "knip": "^6.32.1",
    "mocha": "^11.8.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "1.62.1",
    "rimraf": "6.1.3",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "^4.1.10",
    "yazl": "3.3.1"
  },
  "activationEvents": [
    "onCustomEditor:compressPreview"
  ],
  "contributes": {
    "configuration": {
      "title": "Compress Preview",
      "properties": {
        "compress-preview.listTimeoutMs": {
          "type": "number",
          "default": 10000,
          "minimum": 1000,
          "maximum": 300000,
          "markdownDescription": "Maximum time in milliseconds to spend building the archive entry list before returning partial results. Increase for very large archives on slow disks."
        },
        "compress-preview.watchArchiveFile": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "When enabled, the preview reloads automatically when the archive file changes on disk."
        },
        "compress-preview.tempPreviewMaxAgeDays": {
          "type": "number",
          "default": 7,
          "minimum": 1,
          "maximum": 365,
          "markdownDescription": "Remove cached binary preview folders under the OS temp directory after this many days without use."
        },
        "compress-preview.textExtensions": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "markdownDescription": "Additional file extensions to treat as text previews (without dots, for example `toml`, `lock`)."
        },
        "compress-preview.maxTextPreviewBytes": {
          "type": "number",
          "default": 2097152,
          "minimum": 0,
          "maximum": 104857600,
          "markdownDescription": "Maximum decompressed size in bytes for text previews. Larger files prompt to extract or open once anyway. Set to `0` to disable the limit."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "compressPreview",
        "displayName": "Compress Preview",
        "selector": [
          {
            "filenamePattern": "*.zip"
          },
          {
            "filenamePattern": "*.jar"
          },
          {
            "filenamePattern": "*.apk"
          },
          {
            "filenamePattern": "*.vsix"
          },
          {
            "filenamePattern": "*.xpi"
          },
          {
            "filenamePattern": "*.whl"
          },
          {
            "filenamePattern": "*.war"
          },
          {
            "filenamePattern": "*.ear"
          },
          {
            "filenamePattern": "*.epub"
          },
          {
            "filenamePattern": "*.docx"
          },
          {
            "filenamePattern": "*.pptx"
          },
          {
            "filenamePattern": "*.xlsx"
          },
          {
            "filenamePattern": "*.odt"
          },
          {
            "filenamePattern": "*.ods"
          },
          {
            "filenamePattern": "*.odp"
          },
          {
            "filenamePattern": "*.aar"
          },
          {
            "filenamePattern": "*.crx"
          },
          {
            "filenamePattern": "*.nupkg"
          },
          {
            "filenamePattern": "*.cbz"
          },
          {
            "filenamePattern": "*.kmz"
          },
          {
            "filenamePattern": "*.ipa"
          },
          {
            "filenamePattern": "*.appx"
          },
          {
            "filenamePattern": "*.msix"
          },
          {
            "filenamePattern": "*.tar"
          },
          {
            "filenamePattern": "*.tgz"
          },
          {
            "filenamePattern": "*.tar.gz"
          },
          {
            "filenamePattern": "*.tbz2"
          },
          {
            "filenamePattern": "*.tbz"
          },
          {
            "filenamePattern": "*.tar.bz2"
          },
          {
            "filenamePattern": "*.tar.bzip2"
          },
          {
            "filenamePattern": "*.txz"
          },
          {
            "filenamePattern": "*.tar.xz"
          },
          {
            "filenamePattern": "*.tzst"
          },
          {
            "filenamePattern": "*.tar.zst"
          },
          {
            "filenamePattern": "*.tar.zstd"
          },
          {
            "filenamePattern": "*.gz"
          },
          {
            "filenamePattern": "*.bz2"
          },
          {
            "filenamePattern": "*.bzip2"
          },
          {
            "filenamePattern": "*.xz"
          },
          {
            "filenamePattern": "*.lzma"
          },
          {
            "filenamePattern": "*.zst"
          },
          {
            "filenamePattern": "*.zstd"
          },
          {
            "filenamePattern": "*.7z"
          }
        ]
      }
    ]
  }
}
